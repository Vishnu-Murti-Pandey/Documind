# Copy this file to `.env.production` on the Oracle VM and replace every
# placeholder. Never commit `.env.production` or real credentials.
ENVIRONMENT=production
DEBUG=false
LOW_MEMORY_MODE=false

# Comma-separated exact browser origins, without trailing slashes.
ALLOWED_ORIGINS=https://documind-labs.vercel.app
CORS_ORIGIN_REGEX=

# Neon pooled connection string.
DATABASE_URL=postgresql://USER:PASSWORD@NEON_POOLED_HOST/DATABASE?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Cloudflare R2 S3 endpoint hostname (no https://).
MINIO_ENDPOINT=ACCOUNT_ID.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=R2_ACCESS_KEY_ID
MINIO_SECRET_KEY=R2_SECRET_ACCESS_KEY
MINIO_BUCKET=documind-documents
MINIO_SECURE=true
MINIO_REGION=auto

# Qdrant Cloud cluster URL and database API key.
QDRANT_URL=https://YOUR_CLUSTER.cloud.qdrant.io:6333
QDRANT_API_KEY=QDRANT_DATABASE_API_KEY
QDRANT_TIMEOUT_SECONDS=30
QDRANT_SPARSE_TEXT_EMBEDDING=Qdrant/bm25

OPENAI_API_KEY=OPENAI_API_KEY
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
HF_TOKEN=HUGGING_FACE_TOKEN

CONVERSATION_HISTORY_LIMIT=10
MAX_UPLOAD_SIZE_MB=50
